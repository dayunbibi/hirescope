# Defaults to a local SQLite file (./hirescope.db) if left unset.
# For production, use the Neon connection string, e.g.:
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# "postgres://" URLs are also accepted.
DATABASE_URL=

# Deployed frontend URL allowed to call the API (CORS), e.g. https://hirescope.vercel.app
FRONTEND_URL=

# Optional: extra comma-separated origins (CORS).
# Defaults to http://localhost:3000 if unset.
ALLOWED_ORIGINS=
