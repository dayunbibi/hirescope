# Defaults to a local SQLite file (./hirescope.db) if left unset.
# For production, point this at Postgres, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/hirescope
# "postgres://" URLs (as issued by Railway) are also accepted.
DATABASE_URL=

# Comma-separated frontend origins allowed to call the API (CORS).
# Defaults to http://localhost:3000 if unset.
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=
